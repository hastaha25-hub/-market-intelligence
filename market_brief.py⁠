import datetime
import os
import pytz
import requests

DISCORD_WEBHOOK_URL = os.environ.get("DISCORD_WEBHOOK_URL")
PKT_TZ = pytz.timezone("Asia/Karachi")

SYMBOLS = {
    "GC=F": {"name": "XAUUSD (Gold)", "digits": 2},
    "EURUSD=X": {"name": "EURUSD", "digits": 5},
    "GBPUSD=X": {"name": "GBPUSD", "digits": 5}
}

def get_red_news_blackouts():
    url = "https://nfs.faireconomy.media/ff_calendar_thisweek.json"
    headers = {"User-Agent": "Mozilla/5.0"}
    today_pkt = datetime.datetime.now(PKT_TZ).date()
    blackout_list = []

    try:
        res = requests.get(url, headers=headers, timeout=10)
        if res.status_code == 200:
            events = res.json()
            for ev in events:
                if ev.get("impact") == "High" and ev.get("country") in ["USD", "EUR", "GBP"]:
                    ev_utc = datetime.datetime.fromisoformat(ev.get("date").replace("Z", "+00:00"))
                    ev_pkt = ev_utc.astimezone(PKT_TZ)
                    if ev_pkt.date() == today_pkt:
                        b_start = (ev_pkt - datetime.timedelta(minutes=30)).strftime("%I:%M %p")
                        b_end = (ev_pkt + datetime.timedelta(minutes=30)).strftime("%I:%M %p")
                        blackout_list.append({
                            "title": ev.get("title"),
                            "curr": ev.get("country"),
                            "time": ev_pkt.strftime("%I:%M %p"),
                            "window": f"{b_start} - {b_end}"
                        })
    except Exception as e:
        print(f"News fetch error: {e}")
    return blackout_list

def fetch_candles(ticker, interval, range_val):
    url = f"https://query1.finance.yahoo.com/v8/finance/chart/{ticker}?interval={interval}&range={range_val}"
    headers = {"User-Agent": "Mozilla/5.0"}
    try:
        r = requests.get(url, headers=headers, timeout=10).json()
        quote = r['chart']['result'][0]['indicators']['quote'][0]
        candles = []
        for i in range(len(quote['close'])):
            if quote['close'][i] is not None:
                candles.append({
                    'open': quote['open'][i],
                    'high': quote['high'][i],
                    'low': quote['low'][i],
                    'close': quote['close'][i]
                })
        return candles
    except Exception:
        return []

def analyze_crt_alignment(ticker, meta):
    d = meta['digits']
    w_data = fetch_candles(ticker, "1wk", "1mo")
    d_data = fetch_candles(ticker, "1d", "10d")

    if len(d_data) < 2 or len(w_data) < 2:
        return None

    prev_week = w_data[-2]
    prev_day = d_data[-2]
    current_day = d_data[-1]

    pwh, pwl = prev_week['high'], prev_week['low']
    pdh, pdl = prev_day['high'], prev_day['low']
    eq_daily = (pdh + pdl) / 2
    cur_price = current_day['close']

    swept_pdh = current_day['high'] > pdh
    swept_pdl = current_day['low'] < pdl

    if swept_pdl and not swept_pdh:
        crt_state = "Bullish CRT (Sell-side Swept -> Targeting Buy-side PDH)"
        bias = "BULLISH 🟢"
        probability = "75% - 82%"
        invalidation = f"Sustained 4H Close below {current_day['low']:.{d}f}"
        next_move = f"Sweep London low -> Shift MSS on 5M -> Expand to PDH ({pdh:.{d}f})"
    elif swept_pdh and not swept_pdl:
        crt_state = "Bearish CRT (Buy-side Swept -> Targeting Sell-side PDL)"
        bias = "BEARISH 🔴"
        probability = "75% - 82%"
        invalidation = f"Sustained 4H Close above {current_day['high']:.{d}f}"
        next_move = f"Sweep London high -> Shift MSS on 5M -> Expand to PDL ({pdl:.{d}f})"
    else:
        bias = "BULLISH 🟢" if cur_price > eq_daily else "BEARISH 🔴"
        crt_state = "Inside CRT Range (Expansion towards Liquidity Edge)"
        probability = "65% - 70%"
        invalidation = f"Break of 50% Equilibrium ({eq_daily:.{d}f})"
        target = pdh if bias == "BULLISH 🟢" else pdl
        next_move = f"Mitigate local 4H FVG -> Breakout towards {target:.{d}f}"

    zone_status = "DISCOUNT (Favorable for Longs)" if cur_price < eq_daily else "PREMIUM (Favorable for Shorts)"

    return {
        "name": meta['name'],
        "bias": bias,
        "probability": probability,
        "crt_state": crt_state,
        "cur_price": f"{cur_price:.{d}f}",
        "pdh": f"{pdh:.{d}f}",
        "pdl": f"{pdl:.{d}f}",
        "pwh": f"{pwh:.{d}f}",
        "pwl": f"{pwl:.{d}f}",
        "eq": f"{eq_daily:.{d}f}",
        "zone": zone_status,
        "next_move": next_move,
        "invalidation": invalidation
    }

